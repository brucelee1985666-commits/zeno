+++ b/include/zensim/cuda/memory/TransferProfiler.hpp
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace zs {
+namespace transfer_profile {
+
+enum class Direction : unsigned { HtoD = 0, DtoH = 1, DtoD = 2, Count = 3 };
+
+struct Snapshot {
+  std::uint64_t h_to_d_bytes = 0;
+  std::uint64_t d_to_h_bytes = 0;
+  std::uint64_t d_to_d_bytes = 0;
+  std::uint64_t h_to_d_calls = 0;
+  std::uint64_t d_to_h_calls = 0;
+  std::uint64_t d_to_d_calls = 0;
+};
+
+struct Counters {
+  std::atomic<std::uint64_t> bytes[3]{{0}, {0}, {0}};
+  std::atomic<std::uint64_t> calls[3]{{0}, {0}, {0}};
+};
+
+inline Counters &counters() {
+  static Counters value;
+  return value;
+}
+
+inline void record(Direction direction, std::size_t bytes) noexcept {
+  const auto i = static_cast<unsigned>(direction);
+  if (i >= static_cast<unsigned>(Direction::Count)) return;
+  counters().bytes[i].fetch_add(static_cast<std::uint64_t>(bytes),
+                                std::memory_order_relaxed);
+  counters().calls[i].fetch_add(1, std::memory_order_relaxed);
+}
+
+inline Snapshot snapshot() noexcept {
+  auto &c = counters();
+  Snapshot s;
+  s.h_to_d_bytes = c.bytes[0].load(std::memory_order_relaxed);
+  s.d_to_h_bytes = c.bytes[1].load(std::memory_order_relaxed);
+  s.d_to_d_bytes = c.bytes[2].load(std::memory_order_relaxed);
+  s.h_to_d_calls = c.calls[0].load(std::memory_order_relaxed);
+  s.d_to_h_calls = c.calls[1].load(std::memory_order_relaxed);
+  s.d_to_d_calls = c.calls[2].load(std::memory_order_relaxed);
+  return s;
+}
+
+inline void reset() noexcept {
+  auto &c = counters();
+  for (unsigned i = 0; i != 3; ++i) {
+    c.bytes[i].store(0, std::memory_order_relaxed);
+    c.calls[i].store(0, std::memory_order_relaxed);
+  }
+}
+
+}  // namespace transfer_profile
+}  // namespace zs
